{
  "appearance": {
    "label_color": "#0d47a1",
    "input_border": "#dddddd",
    "btn_bg": "#25d366"
  },
  "formulaire": [
    {
      "type": "text",
      "id": "nom",
      "label": "Nom et prénom",
      "placeholder": "Saisissez votre nom complet",
      "required": true
    },
    {
      "type": "email",
      "id": "email",
      "label": "Adresse e-mail (facultative)",
      "placeholder": "exemple@domaine.com",
      "required": false
    },
    {
      "type": "select",
      "id": "subject",
      "label": "Motif de votre demande",
      "options": [
        "Réservation",
        "Demande de devis",
        "Demande d’information"
      ],
      "placeholder": "Sélectionnez un motif",
      "required": true
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Votre message",
      "placeholder": "Décrivez votre demande en quelques mots.",
      "required": true
    }
  ]
}
